# ==========================================
# Movie Promo Bot - Environment Configuration
# ==========================================

# 1. Telegram Bot Credentials (Get from @BotFather in Telegram)
# Format: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz1234567
BOT_TOKEN="your_telegram_bot_token_here"

# 2. Render Deployment & Webhook Setup
# The public HTTPS URL where your Render service is deployed
WEBHOOK_URL="https://your-service-name.onrender.com"

# Secret token used by Telegram in X-Telegram-Bot-Api-Secret-Token header
# Generate a random 32+ character alphanumeric string
WEBHOOK_SECRET="generate_a_random_32_char_secret_string"

# 3. Target Group Restriction
# Telegram group or supergroup ID to monitor (typically starts with -100 for supergroups)
# Messages outside this group are ignored to prevent accidental promotions in wrong chats
GROUP_ID="-1001234567890"

# 4. Promotion Settings
# Your social-connection website URL to promote
WEBSITE_URL="https://your-social-website.com"

# Number of eligible movie requests before triggering a promotional post (default: 10)
PROMO_THRESHOLD="10"

# Minimum delay between promotions in minutes (default: 30)
PROMO_COOLDOWN_MINUTES="30"

# 5. Administrator Authorization
# Comma-separated list of Telegram user IDs allowed to run admin commands (/promo_on, /promo_off, /promo_reset)
# (Telegram group owners/admins are also recognized automatically in the group)
ADMIN_USER_IDS="123456789,987654321"

# 6. Database Storage
# For Render Production: connect to Render PostgreSQL instance (or Neon / Supabase)
# If omitted in development, the bot automatically uses embedded SQLite at SQLITE_PATH
DATABASE_URL="postgres://username:password@hostname:5432/dbname"

# SQLite storage path for local development (default: ./data/movie_promo.db)
SQLITE_PATH="./data/movie_promo.db"

# 7. Server Runtime
NODE_ENV="production"
PORT="3000"
RUN_MODE="webhook" # "webhook" for Render production, "polling" for local development without public IP

# 8. Title Detection Tuning
DETECTOR_MIN_LENGTH="2"
DETECTOR_MAX_LENGTH="80"
DETECTOR_IGNORED_WORDS="hi,hello,hey,good morning,thanks,thank you,ok,admin,help,how to download"
